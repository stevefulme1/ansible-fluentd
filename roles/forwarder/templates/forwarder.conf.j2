# {{ ansible_managed }}
# Fluentd forwarder configuration

<system>
  log_level info
</system>

{% for source in forwarder_sources %}
<source>
  @type {{ source.type }}
  tag {{ source.tag }}
{% if source.type == 'tail' %}
  path {{ source.path }}
  pos_file {{ source.pos_file }}
  <parse>
    @type {{ source.parse_type | default('none') }}
  </parse>
{% endif %}
{% if source.type == 'syslog' %}
  port {{ source.port | default(5140) }}
  bind {{ source.bind | default('0.0.0.0') }}
{% endif %}
</source>

{% endfor %}
<match **>
  @type forward

  <server>
    host {{ forwarder_aggregator_host }}
    port {{ forwarder_aggregator_port }}
  </server>

  heartbeat_type {{ forwarder_heartbeat_type }}

  <buffer>
    @type {{ forwarder_buffer_type }}
{% if forwarder_buffer_type == 'file' %}
    path {{ forwarder_buffer_path }}
{% endif %}
    flush_interval {{ forwarder_flush_interval }}
    retry_max_times {{ forwarder_retry_max_times }}
  </buffer>
</match>
